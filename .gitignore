# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all variables files which might contain secrets
*.tfvars
*.tfvars.json

# Ignore override files as they are local-only overrides
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# OS files
.DS_Store
Thumbs.db
# Private keys
*.pem
*.key

# Downloaded templates (local only)
temp-main/

# Sensitive secrets (never commit)
**/email-secret.yaml

# Local binaries and tools
bin/
*.exe

